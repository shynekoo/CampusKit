<?xml version="1.0" encoding="utf-8"?>
<!-- The artwork already fills the square, so the background layer carries the whole picture and
     the launcher's own mask decides the outline; the foreground stays empty rather than double
     scaling the same drawing. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_app_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
