<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="InstantWeekPopup">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>
    <style name="CourseSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#275DAD</item>
        <item name="android:colorControlActivated">#275DAD</item>
        <item name="android:buttonStyle">@style/CampusButton</item>
        <item name="android:windowBackground">#F6F7F9</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F6F7F9</item>
        <item name="android:navigationBarColor">#F6F7F9</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>
    <style name="AppDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">#275DAD</item>
    </style>
    <!-- 深色模式下的对话框：白纸上写白字是看不清的，所以对话框自己也有一份深色。
         由 Theme.dialog() 在运行时挑，因为活动主题在 onCreate 返回之前就已经定下了。 -->
    <style name="AppDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background_dark</item>
        <item name="android:colorBackground">#1A1F27</item>
        <item name="android:colorAccent">#8FB0E4</item>
        <item name="android:textColorPrimary">#E9EEF6</item>
        <item name="android:textColorSecondary">#98A4B5</item>
        <item name="android:textColorHint">#7C8798</item>
    </style>
    <!-- 返回手势动画：页面从右侧滑入、向右滑出，和系统的返回手势接上同一个方向。 -->
    <style name="SlidePage">
        <item name="android:windowEnterAnimation">@anim/page_enter</item>
        <item name="android:windowExitAnimation">@anim/page_exit</item>
    </style>
    <style name="CampusButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_surface</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
