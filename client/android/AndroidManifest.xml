<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.qzxy.lite.preview" android:versionCode="235" android:versionName="2.6.0-beta.18">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The only way to apply an update is to hand a package to the system installer;
         the app never installs anything the reader has not agreed to. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Android 11+ hides other packages unless they are declared here; without this,
         getLaunchIntentForPackage() returns null for the pickup-code fallbacks. -->
    <queries>
        <package android:name="com.klcxkj.zqxy" />
        <package android:name="com.cloudora.android" />
        <package android:name="cn.com.yunma.school.app" />
        <package android:name="com.cainiao.wireless" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="hk.alipay.wallet" />
        <!-- 支付宝 SDK 的 H5 授权会尝试唤起手淘；不声明的话 Android 11+ 看不到它。 -->
        <intent>
            <action android:name="*" />
            <data android:scheme="tbopen" />
        </intent>
    </queries>
    <application android:name=".App" android:enableOnBackInvokedCallback="true" android:label="科信小助手" android:theme="@style/AppTheme" android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_app" android:roundIcon="@mipmap/ic_app" android:allowBackup="false" android:supportsRtl="true">
        <!-- Declared by the Alipay SDK's own manifest; optional, so devices without it still install. -->
        <uses-library android:name="org.apache.http.legacy" android:required="false" />
        <activity android:name=".TimetableActivity" android:exported="true" android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".TimetableWebActivity" android:exported="false" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".QzxyAlipayActivity" android:exported="false" />
        <activity android:name=".AccountInfoActivity" android:exported="false" />
        <activity android:name=".UseCodeActivity" android:exported="false" />
        <activity android:name=".AcademicActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <activity android:name=".AcademicStatusActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <activity android:name=".EvaluationActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <activity android:name=".EvaluationFormActivity" android:exported="false" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EduAccountActivity" android:exported="false" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EduLoginActivity" android:exported="false" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EduQueryActivity" android:exported="false" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EduResultActivity" android:exported="false" />
        <activity android:name=".EduPortalActivity" android:exported="false" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".EduTimetableImportActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <activity android:name=".SchoolSiteActivity" android:exported="false" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AccountActivity" android:exported="false" />
        <activity android:name=".LifeDeviceActivity" android:exported="false" />
        <activity android:name=".LifeLoginActivity" android:exported="false" />
        <!-- 支付宝 SDK：授权/支付需要这几页做回跳与中转，权限与 queries 见 SDK 自带清单。 -->
        <activity android:name="com.alipay.sdk.app.H5PayActivity" android:exported="false"
            android:configChanges="orientation|keyboardHidden|navigation|screenSize|locale|keyboard|screenLayout|density|fontScale|layoutDirection|smallestScreenSize"
            android:theme="@android:style/Theme.NoTitleBar" />
        <activity android:name="com.alipay.sdk.app.H5AuthActivity" android:exported="false"
            android:configChanges="orientation|keyboardHidden|navigation|screenSize|locale|keyboard|screenLayout|density|fontScale|layoutDirection|smallestScreenSize"
            android:theme="@android:style/Theme.NoTitleBar" />
        <activity android:name="com.alipay.sdk.app.H5OpenAuthActivity" android:exported="false"
            android:configChanges="orientation|keyboardHidden|navigation|screenSize|locale|keyboard|screenLayout|density|fontScale|layoutDirection|smallestScreenSize"
            android:screenOrientation="behind" android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name="com.alipay.sdk.app.APayEntranceActivity" android:exported="false"
            android:configChanges="orientation|keyboardHidden|navigation|screenSize|locale|keyboard|screenLayout|density|fontScale|layoutDirection|smallestScreenSize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name="com.alipay.sdk.app.PayResultActivity" android:exported="true" android:launchMode="singleInstance"
            android:configChanges="orientation|keyboardHidden|navigation|screenSize|locale|keyboard|screenLayout|density|fontScale|layoutDirection|smallestScreenSize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name="com.alipay.sdk.app.AlipayResultActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|navigation|screenSize|locale|keyboard|screenLayout|density|fontScale|layoutDirection|smallestScreenSize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".ScanActivity" android:exported="false" />
        <!-- Hands one downloaded package to the installer. Not exported: a URI minted here is
             only readable while the install intent carrying it is being handled. -->
        <provider android:name=".ApkProvider" android:authorities="io.qzxy.lite.preview.apk"
            android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".PrivacyActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <!-- 使用公告的整篇阅读页；首次启动仍由 NoticeDialog 负责「不再提醒」的选择。 -->
        <activity android:name=".NoticeActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <!-- 更新日志：读取随包内置的 AppChangelog，不联网、不导出。 -->
        <activity android:name=".ChangelogActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <activity android:name=".FeedbackActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <activity android:name=".MoreActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <activity android:name=".AppearanceActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <!-- 运行记录：入口只在测试版的登录页，发布版读者到不了这一页。 -->
        <activity android:name=".DiagActivity" android:exported="false" android:configChanges="orientation|screenSize" />
        <activity android:name=".DiagReportActivity" android:exported="false" android:configChanges="orientation|screenSize" android:windowSoftInputMode="adjustResize" />

        <receiver android:name=".ScheduleWidget" android:exported="false" android:label="科信小助手 2×2 课表">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="android.intent.action.DATE_CHANGED"/><action android:name="android.intent.action.TIME_SET"/><action android:name="android.intent.action.TIMEZONE_CHANGED"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/schedule_widget"/>
        </receiver>
        <receiver android:name=".ScheduleWidgetMedium" android:exported="false" android:label="科信小助手 3×2 课表"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/schedule_widget_medium"/></receiver>
        <receiver android:name=".ScheduleWidgetWide" android:exported="false" android:label="科信小助手 4×2 课表"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/schedule_widget_wide"/></receiver>
    </application>
</manifest>
